# Every one of these is read once at startup. A missing required value
# stops the server immediately rather than surfacing later as a request
# failing for reasons that look unrelated.

# --- Required ---------------------------------------------------------
# Postgres, reached directly. No Hyperdrive in front of it any more, so
# this is the database's own connection string.
DATABASE_URL=postgres://user:password@host:5432/synora?sslmode=require

# Any long random string. Signs access tokens; changing it signs every
# existing device out.
JWT_SECRET=

# R2 over its S3-compatible API. Create the token in the Cloudflare
# dashboard under R2 > Manage R2 API Tokens, with Object Read & Write on
# this bucket. The account id is in the R2 overview page's endpoint URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=synora-bucket

# --- Optional ---------------------------------------------------------
# PORT=8787
# Sized for the instance, not per request - one process serves everything.
# DATABASE_POOL_SIZE=10
# Blocks only NEW signups once total usage nears the free R2 allowance.
# GLOBAL_STORAGE_CEILING_BYTES=8000000000
# How long superseded file versions are kept before collection may take
# them. See src/gc.ts for every other condition that also has to hold.
# GC_RETENTION_DAYS=30
# GC_CRON=17 3 * * *
# Point at something S3-compatible that is not R2, e.g. MinIO locally.
# S3_ENDPOINT=http://localhost:9000
