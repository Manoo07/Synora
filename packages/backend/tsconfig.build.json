{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // Node resolves real files at runtime, unlike the bundler that used
    // to consume this - and the source already imports with explicit
    // .js extensions, which is exactly what NodeNext expects.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
